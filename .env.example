# Copiar este archivo como .env y poner los datos de tu MySQL local
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=impacto_ambiental_db

# Clave para firmar los tokens. En producción usar una larga y aleatoria.
JWT_SECRET=cambia_esta_clave_por_una_segura
JWT_EXPIRES_IN=8h
